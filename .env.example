# Lead delivery (see app/api/lead/route.ts)
# Get a free API key at https://resend.com and verify your sending domain.
# Without a key, leads are logged to the console in development only. In
# production a missing key or a rejected send is reported to the visitor, who
# is then offered WhatsApp / call / email with their answers pre-filled.
#
# IMPORTANT: until kayglocitadel.com is verified in Resend, the default sender
# (onboarding@resend.dev) can ONLY deliver to the email the Resend account was
# opened with. Sending to sales@ before verifying the domain will be rejected.

RESEND_API_KEY=
LEAD_INBOX=sales@kayglocitadel.com
# A verified sender on your domain — set once the domain is verified in Resend.
# LEAD_FROM=Kayglo Leads <leads@kayglocitadel.com>

# ---------------------------------------------------------------------------
# Measurement. Each is optional — the matching script only loads once it's set.
# ---------------------------------------------------------------------------
# Google Analytics 4 property, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Google Ads conversion account, e.g. AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=
# The conversion label for a completed power assessment, e.g. AbC-D_efGh12
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
# Meta (Facebook/Instagram) pixel, for retargeting and lead optimisation
NEXT_PUBLIC_META_PIXEL_ID=

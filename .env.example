# Lead delivery (see app/api/lead/route.ts)
# Get a free API key at https://resend.com and verify your sending domain.
# Without these, leads are logged to the server console instead of emailed.

RESEND_API_KEY=
LEAD_INBOX=hello@kayglo.com
# Optional: a verified sender address on your domain.
# LEAD_FROM=Kayglo Leads <leads@kayglo.com>

# ---------------------------------------------------------------------------
# Measurement. Each is optional — the matching script only loads once it's set.
# ---------------------------------------------------------------------------
# Google Analytics 4 property, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Google Ads conversion account, e.g. AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=
# The conversion label for a completed power assessment, e.g. AbC-D_efGh12
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
# Meta (Facebook/Instagram) pixel, for retargeting and lead optimisation
NEXT_PUBLIC_META_PIXEL_ID=
